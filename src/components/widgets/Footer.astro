---
import LogoIcon from '../../assets/images/treelens_logo.png';

interface Link {
  text?: string;
  href?: string;
}

interface Links {
  title?: string;
  links: Array<Link>;
}

export interface Props {
  links: Array<Links>;
}

const { links = [] } = Astro.props;
---

<footer class="relative border-t border-gray-200 dark:border-slate-800 not-prose">
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 py-10 md:py-14">
    <div class="flex flex-wrap items-center justify-between gap-x-12 gap-y-10">
      <div class="flex flex-wrap gap-x-32 gap-y-8">
        {
          links.map(({ title, links }) => (
            <div>
              <div class="font-bold text-lg mb-3 text-[#4B2F13]">{title}</div>
              {links && Array.isArray(links) && links.length > 0 && (
                <ul class="text-base space-y-1">
                  {links.map(({ text, href }) => (
                    <li>
                      <a
                        class="text-muted dark:text-gray-400 transition duration-150 ease-in-out"
                        href={href}
                      >
                        {text}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          ))
        }
      </div>

      <div class="w-full md:w-1/4 flex justify-end">
        <div class="w-48 md:w-56 lg:w-64 h-auto">
          <img src={LogoIcon.src || "/placeholder.svg"} alt="TreeLens Logo" />
        </div>
      </div>
    </div>
  </div>
</footer>
