---
import LogoIcon from '../../assets/images/treelens_logo.png';

interface Link {
  text?: string;
  href?: string;
}

interface Links {
  title?: string;
  links: Array<Link>;
}

export interface Props {
  links: Array<Links>;
}

const { links = [] } = Astro.props;
---

<footer class="relative border-t border-gray-200 dark:border-slate-800 not-prose">
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 py-10 md:py-14">

    <!-- Logo centrado no topo em mobile -->
    <div class="flex justify-center mb-8 md:hidden">
      <img src={LogoIcon.src} alt="TreeLens Logo" class="w-36 h-auto" />
    </div>

    <div class="flex flex-col md:flex-row md:justify-between gap-8">

      <!-- Colunas de links: grid 2 colunas em mobile, linha em desktop -->
      <div class="grid grid-cols-2 sm:grid-cols-3 md:flex md:flex-row gap-8 md:gap-16">
        {
          links.map(({ title, links }) => (
            <div>
              <div class="font-bold text-base mb-3 text-[#4B2F13]">{title}</div>
              {links && Array.isArray(links) && links.length > 0 && (
                <ul class="text-lg space-y-2">
                  {links.map(({ text, href }) => (
                    <li>
                      <a
                        class="text-muted dark:text-gray-400 transition duration-150 ease-in-out"
                        href={href}
                      >
                        {text}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          ))
        }
      </div>

      <!-- Logo à direita apenas em desktop -->
      <div class="hidden md:flex md:items-start md:justify-end flex-shrink-0">
        <img src={LogoIcon.src} alt="TreeLens Logo" class="w-48 lg:w-64 h-auto" />
      </div>

    </div>
  </div>
</footer>
