---
---

<section class="relative md:-mt-[76px] not-prose">
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6">
    <div class="pt-0 md:pt-[76px] pointer-events-none"></div>
    <div class="py-20 md:py-32">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">

        <!-- Coluna da Esquerda: Textos e Botão -->
        <div class="text-center md:text-left">
          <h1 class="text-5xl md:text-6xl lg:text-7xl font-bold leading-tighter tracking-tighter mb-4 font-heading text-[#623B14] dark:text-[#e8c99a]">
            Every <span class="text-[#5F7C4C] dark:text-[#7a9e62]">Tree</span> <br class="hidden sm:inline" />
            In Your City <br class="hidden sm:inline" />
            <span class="text-[#9CB66E]">Detected, Located and Mapped</span>
          </h1>
          <p class="text-[1.05rem] text-[#4B2F13] dark:text-[#e8c99a]/66 mb-4 max-w-xl mx-auto md:mx-0">
            Because the urban tree inventory should not depend on tree-by-tree surveys.
          </p>

          <div class="flex justify-center md:justify-start">
            <a
              id="learn-more-btn"
              class="inline-flex items-center justify-center bg-[#CB8F30] hover:bg-[#b07a28] text-white font-medium px-8 py-3 rounded-full shadow-lg transition-all duration-300 cursor-pointer"
            >
              Learn more
            </a>
          </div>
        </div>

        <!-- Coluna da Direita: Imagem -->
        <div class="relative flex justify-center">
          <img
            src="src/assets/images/landing-page.png"
            alt="TreeLens illustration"
            class="w-full max-w-2xl h-auto object-contain"
          />
        </div>

      </div>
    </div>
  </div>
</section>

<!-- SECÇÃO: Say Goodbye to Field Surveys -->
<section id="features" class="py-20 md:py-28 not-prose">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">

    <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold text-center font-heading mb-16 text-[#623B14] dark:text-[#e8c99a]">
      Say <span class="text-[#CB8F30]">Goodbye</span> to Field Surveys
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-16 gap-y-12">

      <!-- Item 1 -->
      <div class="flex items-start gap-5">
        <div class="flex-shrink-0 w-12 h-12 rounded-full bg-[#5F7C4C] flex items-center justify-center shadow-md">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M3 8a1 1 0 011-1h8a1 1 0 011 1v8a1 1 0 01-1 1H4a1 1 0 01-1-1V8z" />
          </svg>
        </div>
        <div>
          <h3 class="text-xl font-bold text-[#5F7C4C] mb-2">Image & Video Ingestion</h3>
          <p class="text-[1.05rem] text-[#4B2F13] dark:text-[#e8c99a]/66">
            Select a zone on the map or upload GPS-tagged videos, with automatic blurring of faces and licence plates (GDPR).
          </p>
        </div>
      </div>

      <!-- Item 2 -->
      <div class="flex items-start gap-5">
        <div class="flex-shrink-0 w-12 h-12 rounded-full bg-[#5F7C4C] flex items-center justify-center shadow-md">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
          </svg>
        </div>
        <div>
          <h3 class="text-xl font-bold text-[#5F7C4C] mb-2">Automatic Detection & Registration</h3>
          <p class="text-[1.05rem] text-[#4B2F13] dark:text-[#e8c99a]/66">
            Merging of repeated detections, location via triangulation, and confidence scoring.
          </p>
        </div>
      </div>

      <!-- Item 3 -->
      <div class="flex items-start gap-5">
        <div class="flex-shrink-0 w-12 h-12 rounded-full bg-[#5F7C4C] flex items-center justify-center shadow-md">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
          </svg>
        </div>
        <div>
          <h3 class="text-xl font-bold text-[#5F7C4C] mb-2">Tree Characterisation</h3>
          <p class="text-[1.05rem] text-[#4B2F13] dark:text-[#e8c99a]/66">
            Species or genus, size, and visible signs of poor condition.
          </p>
        </div>
      </div>

      <!-- Item 4 -->
      <div class="flex items-start gap-5">
        <div class="flex-shrink-0 w-12 h-12 rounded-full bg-[#5F7C4C] flex items-center justify-center shadow-md">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
          </svg>
        </div>
        <div>
          <h3 class="text-xl font-bold text-[#5F7C4C] mb-2">Management & Statistics</h3>
          <p class="text-[1.05rem] text-[#4B2F13] dark:text-[#e8c99a]/66">
            Statistics by street or parish, and comparison between surveys.
          </p>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  document.getElementById('learn-more-btn')?.addEventListener('click', () => {
    const target = document.getElementById('features');
    if (!target) return;
    const navbarHeight = (document.getElementById('header') as HTMLElement)?.offsetHeight ?? 80;
    const extraSpacing = 48;
    const top = target.getBoundingClientRect().top + window.scrollY - navbarHeight - extraSpacing;
    window.scrollTo({ top, behavior: 'smooth' });
  });
</script>
