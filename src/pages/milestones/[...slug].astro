---
import { getCollection, getEntry, render } from 'astro:content';
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import { getPermalink } from '~/utils/permalinks';

export async function getStaticPaths() {
  const entries = await getCollection('milestones');
  return entries.map((entry) => ({
    params: { slug: entry.id },
  }));
}

const { slug } = Astro.params;
const entry = await getEntry('milestones', slug);

if (!entry) throw new Error(`Milestone not found: ${slug}`);

const { Content } = await render(entry);
const metadata = { title: entry.data.title };
---

<Layout metadata={metadata}>
  <section class="max-w-4xl mx-auto mt-8 p-4 sm:p-6 bg-white rounded-2xl">
    <HeroText title={`<span style='color:#623B14'>${entry.data.title}</span>`} />
    <div class="mx-auto px-4 sm:px-6 max-w-3xl prose prose-md lg:prose-xl dark:prose-invert mt-8 prose-li:my-0.5 prose-ul:my-1 prose-p:my-2 prose-headings:mt-6 prose-headings:mb-2 prose-headings:text-[#623B14] prose-p:text-muted prose-li:text-muted prose-strong:text-[#623B14]">
      <Content />
    </div>
    <div class="mx-auto px-4 sm:px-6 max-w-3xl mt-12 pb-4">
      <a
        href={getPermalink('/milestones')}
        class="inline-flex items-center gap-2 text-[#623B14] font-medium text-base hover:opacity-75 transition-opacity duration-200"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
        Back to Milestones
      </a>
    </div>
  </section>
</Layout>
