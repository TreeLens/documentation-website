---
import Layout from '~/layouts/PageLayout.astro';
import Headline from '~/components/ui/Headline.astro';
import MilestonesList from '~/components/widgets/MilestonesList.astro';
 
const metadata = {
  title: 'Milestones',
};
---
 
<Layout metadata={metadata}>
  <section class="relative mx-auto max-w-7xl px-4 md:px-6 py-16 md:py-20">
    <Headline title="Milestones" classes={{ container: 'md:mx-0 text-left mb-10' }} />
    <MilestonesList layout="vertical" />
  </section>
</Layout>
 
